  "functions": [
    {
      "signature": "concordance_authority_prevent_mutation()",
      "definition": "CREATE OR REPLACE FUNCTION public.concordance_authority_prevent_mutation()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n  raise exception 'concordance authority history is append-protected';\nend;\n$function$\n",
      "proacl": null
    },
    {
      "signature": "concordance_authority_protect_recognition_timestamps()",
      "definition": "CREATE OR REPLACE FUNCTION public.concordance_authority_protect_recognition_timestamps()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n  if tg_table_name = 'concordance_version'\n     and old.recognized_at is not null\n     and new.recognized_at is distinct from old.recognized_at then\n    raise exception 'concordance_version.recognized_at is immutable after recognition';\n  end if;\n\n  if tg_table_name = 'seeded_source_snapshot'\n     and old.verified_at is not null\n     and new.verified_at is distinct from old.verified_at then\n    raise exception 'seeded_source_snapshot.verified_at is immutable after verification';\n  end if;\n\n  return new;\nend;\n$function$\n",
      "proacl": null
    },
    {
      "signature": "concordance_authority_set_updated_at()",
      "definition": "CREATE OR REPLACE FUNCTION public.concordance_authority_set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n",
      "proacl": null
    }
  ],
