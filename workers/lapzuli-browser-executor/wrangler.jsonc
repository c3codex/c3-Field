{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lapzuli-browser-executor",
  "main": "src/index.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER_STATE",
        "class_name": "BrowserState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BrowserState"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DIZZY_BROWSER_IDENTITY": "dizzy_lapzuli_browser_executor_v1",
    "MEDIUM_ACCOUNT_IDENTITY": "unDrifted"
  }
}
